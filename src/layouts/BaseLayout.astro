---
import icon from "../assets/icon.svg";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Notas de estudo sobre desenvolvimento de software.",
} = Astro.props;
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href={icon.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body>
    <header>
      <nav>
        <a href="/" class="brand">phc<span>.log</span></a>

        <div class="nav-links">
          <a href="/">Início</a>
          <a href="/blog">Blog</a>
          <a href="/sobre">Sobre</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>© 2026 Pedro Henrique Camargo</p>
    </footer>
  </body>
</html>

<style>
  :global(:root) {
    --ink: #171a16;
    --ink-soft: #383c33;
    --paper: #f1f2ec;
    --surface: #fbfbf7;
    --line: #dfe0d2;
    --muted: #6b6f60;
    --accent: #3f6b4e;
    --accent-soft: #e3ebe0;

    --font-display: "Fraunces", ui-serif, Georgia, serif;
    --font-body: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace;

    --content-width: min(100% - 40px, 720px);
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    font-family: var(--font-body);
    color: var(--ink);
    background: var(--paper);
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;

    display: flex;
    flex-direction: column;

    background: var(--paper);
    color: var(--ink);

    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  :global(a) {
    color: inherit;
  }

  :global(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  header {
    width: 100%;
    border-bottom: 1px solid var(--line);
    background: rgba(241, 242, 236, 0.85);

    position: sticky;
    top: 0;
    z-index: 10;

    backdrop-filter: blur(12px);
  }

  nav {
    width: var(--content-width);
    min-height: 68px;
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .brand span {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-links a {
    position: relative;

    color: var(--muted);
    text-decoration: none;

    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.01em;

    transition: color 180ms ease;
  }

  .nav-links a::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -7px;

    width: 100%;
    height: 1px;

    background: var(--accent);

    transform: scaleX(0);
    transform-origin: right;

    transition: transform 200ms ease;
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  main {
    width: var(--content-width);
    margin: 0 auto;

    flex: 1;

    padding: 72px 0 100px;
  }

  footer {
    width: var(--content-width);
    margin: 0 auto;

    padding: 28px 0;

    border-top: 1px solid var(--line);

    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  footer p {
    margin: 0;
  }

  /* ---------- Tipografia de conteúdo (posts, sobre, etc.) ---------- */

  :global(.log-stamp) {
    display: inline-block;
    margin: 0 0 10px;

    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }

  :global(.tag-list) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;

    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }

  :global(.tag) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);

    background: var(--accent-soft);
    border-radius: 999px;
    padding: 3px 10px;
  }

  :global(.prose),
  :global(article) {
    font-family: var(--font-body);
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  :global(.prose h1),
  :global(article h1) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.2;
    color: var(--ink);
    margin: 0 0 0.4em;
  }

  :global(.prose h2),
  :global(article h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--ink);
    margin: 2.2em 0 0.7em;
  }

  :global(.prose h2::before),
  :global(article h2::before) {
    content: "§ ";
    color: var(--accent);
    font-family: var(--font-mono);
  }

  :global(.prose h3),
  :global(article h3) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--ink);
    margin: 1.8em 0 0.6em;
  }

  :global(.prose p),
  :global(article p) {
    margin: 0 0 1.3em;
  }

  :global(.prose a),
  :global(article a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  :global(.prose a:hover),
  :global(article a:hover) {
    color: var(--ink);
  }

  :global(.prose strong),
  :global(article strong) {
    color: var(--ink);
    font-weight: 600;
  }

  :global(.prose em),
  :global(article em) {
    font-family: var(--font-display);
    font-style: italic;
  }

  :global(.prose ul),
  :global(.prose ol),
  :global(article ul),
  :global(article ol) {
    margin: 0 0 1.3em;
    padding-left: 1.3em;
  }

  :global(.prose li),
  :global(article li) {
    margin: 0.35em 0;
  }

  :global(.prose li::marker),
  :global(article li::marker) {
    color: var(--accent);
  }

  :global(.prose blockquote),
  :global(article blockquote) {
    margin: 1.6em 0;
    padding: 0.2em 0 0.2em 1.2em;

    border-left: 2px solid var(--accent);
    color: var(--muted);
    font-family: var(--font-display);
    font-style: italic;
  }

  :global(.prose hr),
  :global(article hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2.4em 0;
  }

  :global(.prose img),
  :global(article img) {
    max-width: 100%;
    border-radius: 8px;
    border: 1px solid var(--line);
  }

  :global(.prose code),
  :global(article code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--ink);
    background: var(--accent-soft);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  :global(.prose pre),
  :global(article pre) {
    position: relative;

    background: var(--ink);
    color: #e9ede6;

    padding: 2.6rem 1.4rem 1.4rem;
    border-radius: 10px;
    overflow-x: auto;

    margin: 1.8em 0;
  }

  :global(.prose pre::before),
  :global(article pre::before) {
    content: "";

    position: absolute;
    top: 1rem;
    left: 1.2rem;

    width: 9px;
    height: 9px;
    border-radius: 50%;

    background: #6b6f60;
    box-shadow:
      16px 0 #6b6f60,
      32px 0 #6b6f60;
  }

  :global(.prose pre code),
  :global(article pre code) {
    background: none;
    padding: 0;
    color: inherit;
    font-size: 0.9em;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(*) {
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }

  @media (max-width: 640px) {
    nav {
      min-height: 60px;
      gap: 16px;
    }

    .nav-links {
      gap: 18px;
    }

    .nav-links a {
      font-size: 0.85rem;
    }

    main {
      padding: 48px 0 72px;
    }

    :global(.prose),
    :global(article) {
      font-size: 1rem;
    }
  }
</style>
